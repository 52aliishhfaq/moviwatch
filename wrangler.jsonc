{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviwatch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGINS": "https://moviwatch.vercel.app"
  }
}
