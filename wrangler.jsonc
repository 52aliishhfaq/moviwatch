{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviwatch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "keep_vars": true,
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_REDIRECT_URI",
      "GOOGLE_DRIVE_ENCRYPTION_KEY"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGINS": "https://moviwatch.vercel.app,https://moviwatch-aliishhfaq.vercel.app"
  },
  "cache": {
    "enabled": true
  },
  "compatibility_flags": [
    "enable_ctx_exports"
  ],
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "PublicCatalogue": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "MovieMetadata": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "VideoChunk": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "VideoHeader": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  }
}
